---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const recent = posts.filter((p) => !featured.includes(p)).slice(0, 8);
const paragraphs = site.intro.split(/\n\s*\n/);
---

<Base>
  <section class="intro container">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <div class="bio">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section">
        <h2 class="eyebrow">Start here</h2>
        <PostList posts={featured} />
      </section>
    )
  }

  <section class="container section">
    <div class="section-head">
      <h2 class="eyebrow">Recent writing</h2>
      {posts.length > 0 && <a class="eyebrow" href="/writing/">All writing →</a>}
    </div>
    {
      recent.length > 0 ? (
        <PostList posts={recent} />
      ) : (
        <p class="empty">Nothing published yet.</p>
      )
    }
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(3rem, 12vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .tagline {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-style: italic;
    line-height: 1.35;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .bio {
    max-width: var(--measure);
    margin-top: 2rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .bio p {
    margin: 0;
  }

  .bio p + p {
    margin-top: 0.9rem;
  }

  .section {
    margin-top: 2.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-weight: 400;
  }

  a.eyebrow {
    text-decoration: none;
  }

  a.eyebrow:hover {
    color: var(--accent);
  }

  .empty {
    color: var(--muted);
  }
</style>
