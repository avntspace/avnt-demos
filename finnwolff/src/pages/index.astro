---
import Base from '../layouts/Base.astro';
import { site, postTypes } from '../site.config';
import { getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
const pad = (n: number) => String(n).padStart(2, '0');
// '*excited* about.' -> ['', 'excited', ' about.']: odd entries get highlighted.
const split = (line: string) => line.split('*');
const roles = site.tagline.replace(/\.$/, '').split(/,\s*(?:and\s+)?/);
---

<Base>
  <section class="hero container">
    <div class="hero-top eyebrow">
      <span>[ {roles.join(' · ')} ]</span>
      <span class="since">[ Building since age 5 ]</span>
    </div>

    <h1 class="statement">
      <span class="sr-only">{site.name}: </span>
      {
        site.statement.map((line, i) => (
          <span class="line">
            <span style={`--i: ${i}`}>
              {split(line).map((part, j) => (j % 2 ? <em>{part}</em> : part))}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="hero-foot">
      <p class="intro">{site.intro}</p>
      <a class="eyebrow scroll" href="#story">[ The story <span aria-hidden="true">↓</span> ]</a>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <span class="set">
            {site.worlds.map((w) => (
              <span>
                {w}
                <i>✦</i>
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <section id="story" class="container section">
    <p class="eyebrow label">[ 01 ] The story</p>
    <ol class="chapters">
      {
        site.story.map((c, i) => (
          <>
            <li class="chapter" data-reveal>
              <div class="marker">
                <span class="num">{pad(i + 1)}</span>
                <span class="eyebrow when">{c.when}</span>
              </div>
              <div class="body">
                <h2>{c.title}</h2>
                <p>{c.text}</p>
                {c.links && (
                  <p class="more">
                    {c.links.map((l) => (
                      <a href={l.href}>
                        {l.label} <span aria-hidden="true">→</span>
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </li>
            {c.photo && site.photo && (
              <li class="photo" data-reveal>
                <figure>
                  <img src={site.photo} alt={`${site.name} in ${site.photoCaption}`} loading="lazy" />
                  <figcaption class="eyebrow">[ {site.photoCaption} ]</figcaption>
                </figure>
              </li>
            )}
          </>
        ))
      }
    </ol>
  </section>

  {
    posts.length > 0 && (
      <section id="writing" class="container section">
        <div class="section-head">
          <p class="eyebrow label">[ 02 ] Writing</p>
          <a class="eyebrow" href="/writing/">
            [ Archive → ]
          </a>
        </div>
        <ol class="index">
          {posts.map((post) => (
            <li data-reveal>
              <a href={postUrl(post)}>
                <span class="eyebrow">{post.data.date.getUTCFullYear()}</span>
                <span class="title">{post.data.title}</span>
                <span class="eyebrow type">{postTypes[post.data.type]}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: calc(100svh - 4rem);
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
  }

  .statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 11.2vw, 11rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  /* Each line rises out of its own mask on load. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .line > span {
    display: block;
    animation: rise 1.2s var(--ease-out) both;
    animation-delay: calc(var(--i) * 0.12s + 0.1s);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  .statement em {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    animation: fade 1.2s var(--ease-out) 0.6s both;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .intro {
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .scroll {
    flex-shrink: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .scroll span {
    display: inline-block;
    color: var(--accent);
    animation: nudge 2s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }

  /* ---------- Ticker ---------- */

  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--rule);
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
  }

  .set span {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .set i {
    margin-inline: clamp(1rem, 3vw, 2.5rem);
    font-style: normal;
    font-size: 0.5em;
    vertical-align: middle;
    color: var(--accent);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line > span,
    .hero-foot,
    .scroll span,
    .track {
      animation: none;
    }
  }

  /* ---------- Sections ---------- */

  .section {
    margin-top: clamp(5rem, 12vw, 10rem);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .label {
    margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
    color: var(--ink);
  }

  .section-head a {
    text-decoration: none;
  }

  /* ---------- Story ---------- */

  .chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 2.2fr;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2.25rem, 5vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .marker {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
  }

  .when {
    color: var(--accent);
  }

  .body h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 4.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .body p {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .body .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .more a {
    color: var(--ink);
    text-decoration: none;
  }

  .more a span {
    color: var(--accent);
  }

  /* Full-bleed photo that comes into color as it scrolls in. */
  .photo {
    margin-inline: calc(50% - 50vw);
    padding-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .photo figure {
    margin: 0;
    overflow: hidden;
  }

  .photo img {
    display: block;
    width: 100%;
    height: min(85svh, 56vw);
    object-fit: cover;
    object-position: 40% 55%;
    filter: grayscale(1) contrast(1.15) brightness(0.8);
    transform: scale(1.06);
    transition:
      filter 2.4s var(--ease-out) 0.3s,
      transform 2.4s var(--ease-out);
  }

  .photo.in img {
    filter: none;
    transform: none;
  }

  .photo figcaption {
    padding: 0.9rem var(--gutter) 0;
  }

  /* ---------- Writing index ---------- */

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .index a {
    display: grid;
    grid-template-columns: 5rem 1fr auto 1.5rem;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }

  .index .title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    transition:
      transform 0.4s var(--ease-out),
      color 0.2s;
  }

  .index .arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.2s,
      transform 0.4s var(--ease-out);
  }

  .index a:hover .title {
    transform: translateX(10px);
    color: var(--ink);
  }

  .index a:hover .arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 82svh;
    }

    .hero-top {
      letter-spacing: 0.02em;
    }

    .hero-top .since {
      display: none;
    }

    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .chapter {
      grid-template-columns: 1fr;
    }

    .marker {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }

    .index a {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }

    .index .title {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .index .arrow {
      display: none;
    }
  }
</style>
