---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, allTags, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === tag.slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`Writing tagged ${name}.`}>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow"><a href="/writing/">Writing</a> / Topic</p>
      <h1>#{name}</h1>
    </header>
    <PostList posts={posts} />
  </div>
</Base>

<style>
  .page-header {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
  }

  .eyebrow a {
    text-decoration: none;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
</style>
