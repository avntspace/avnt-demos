---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { postTypes } from '../../site.config';
import { getPosts, allTags } from '../../lib/posts';

const posts = await getPosts();
const tags = allTags(posts);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}

// Only offer filters for types that actually have posts.
const types = Object.entries(postTypes).filter(([key]) => posts.some((p) => p.data.type === key));
---

<Base title="Writing" description="Essays, notes, and analyses.">
  <div class="container">
    <header class="page-header">
      <h1>Writing</h1>
      <p>Essays, notes, and analyses: {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} so far.</p>
    </header>

    {
      types.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by type">
          <button type="button" data-filter="all" aria-pressed="true">
            All
          </button>
          {types.map(([key, label]) => (
            <button type="button" data-filter={key} aria-pressed="false">
              {label}
            </button>
          ))}
        </div>
      )
    }

    {
      [...byYear.entries()].map(([year, yearPosts]) => (
        <section class="year" data-year>
          <h2 class="eyebrow">{year}</h2>
          <PostList posts={yearPosts} />
        </section>
      ))
    }

    {
      tags.length > 0 && (
        <section class="tag-cloud">
          <h2 class="eyebrow">Topics</h2>
          <ul>
            {tags.map((t) => (
              <li>
                <a href={`/tags/${t.slug}/`}>
                  {t.name} <span>{t.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');

  function apply(filter: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    document.querySelectorAll<HTMLElement>('.year').forEach((section) => {
      let visible = 0;
      section.querySelectorAll<HTMLElement>('li[data-type]').forEach((li) => {
        const show = filter === 'all' || li.dataset.type === filter;
        li.hidden = !show;
        if (show) visible++;
      });
      section.hidden = visible === 0;
    });
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const filter = b.dataset.filter ?? 'all';
      apply(filter);
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', filter);
      history.replaceState(null, '', url);
    }),
  );

  const initial = new URLSearchParams(location.search).get('type');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>

<style>
  .page-header {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .page-header p {
    margin: 0.9rem 0 0;
    color: var(--muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .filters button {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filters button:hover {
    border-color: var(--ink-soft);
  }

  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .year + .year {
    margin-top: 3rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-weight: 400;
  }

  .tag-cloud {
    margin-top: 4.5rem;
  }

  .tag-cloud ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-cloud a {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .tag-cloud a:hover {
    border-color: var(--accent);
  }

  .tag-cloud span {
    margin-left: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
