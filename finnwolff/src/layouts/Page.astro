---
// Layout for simple Markdown pages in src/pages (e.g. about.md).
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="container narrow">
    <header>
      <h1>{frontmatter.title}</h1>
      {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
    </header>
    {frontmatter.image && <img class="cover" src={frontmatter.image} alt={frontmatter.imageAlt ?? ''} />}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  header {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    margin-bottom: 2.25rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .lead {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-style: italic;
    line-height: 1.1;
    color: var(--accent);
    text-wrap: balance;
  }

  .cover {
    display: block;
    width: 100%;
    margin: 0 0 3rem;
    border-radius: 2px;
    filter: grayscale(1) contrast(1.1);
    transition: filter 1.2s var(--ease-out);
  }

  .cover:hover {
    filter: none;
  }
</style>
