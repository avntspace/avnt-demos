---
// Layout for simple Markdown pages in src/pages (e.g. about.md).
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="container narrow">
    <header>
      <h1>{frontmatter.title}</h1>
      {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
    </header>
    {frontmatter.image && <img class="cover" src={frontmatter.image} alt={frontmatter.imageAlt ?? ''} />}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  header {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    margin-bottom: 2.25rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .lead {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3.2vw, 1.75rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--accent);
    text-wrap: balance;
  }

  .cover {
    display: block;
    width: 100%;
    margin: 0 0 2.5rem;
    border-radius: 1.25rem;
  }
</style>
