---
import { postTypes } from '../site.config';
import { formatDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showDescription?: boolean;
}

const { posts, showDescription = true } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li data-type={post.data.type}>
        <a href={postUrl(post)}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short')}</time>
          <span class="body">
            <span class="title">
              {post.data.title}
              {post.data.draft && <span class="draft">Draft</span>}
            </span>
            {showDescription && post.data.description && (
              <span class="description">{post.data.description}</span>
            )}
          </span>
          <span class="type">{postTypes[post.data.type]}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  li:first-child a {
    border-top: 1px solid var(--rule);
  }

  time,
  .type {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--ink);
    transition: color 0.15s;
  }

  a:hover .title {
    color: var(--accent);
  }

  .description {
    font-size: 0.925rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .type {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border: 1px dashed var(--accent);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: middle;
  }

  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr auto;
    }

    time {
      grid-row: 1;
    }

    .type {
      grid-row: 1;
      text-align: right;
    }

    .body {
      grid-column: 1 / -1;
    }
  }
</style>
