---
import { site } from '../site.config';

const links = site.links.filter((l) => l.href);
const year = new Date().getFullYear();
---

<footer class="site-footer container">
  <span>© {year} {site.name}</span>
  <nav aria-label="Elsewhere">
    {site.email && <a href={`mailto:${site.email}`}>Email</a>}
    {links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
    <a href="/rss.xml">RSS</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 6rem;
    padding-top: 1.75rem;
    padding-bottom: 2.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    /* Top rule drawn inside the gutters */
    background: linear-gradient(var(--rule), var(--rule)) no-repeat var(--gutter) 0 / calc(100% - var(--gutter) * 2) 1px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  a {
    text-decoration: none;
  }
</style>
