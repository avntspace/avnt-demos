---
// An image (or any embed) with a caption, for MDX posts:
//   <Figure src="/images/chart.png" alt="..." caption="Source: ..." />
//   <Figure caption="..."><iframe ... /></Figure>
//   <Figure wide ...> breaks out of the text column on large screens.
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt = '', caption, wide = false } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <slot />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-inline: 0;
  }

  .figure.wide {
    margin-inline: calc((min(var(--wide), 100vw - var(--gutter) * 2) - min(var(--measure), 100vw - var(--gutter) * 2)) / -2);
  }

  .figure :global(img),
  .figure :global(iframe),
  .figure :global(svg) {
    display: block;
    width: 100%;
    border-radius: 4px;
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
